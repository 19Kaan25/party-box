# PartyBox — Environment-Variablen
#
# Diese Datei ist eine Vorlage. Echte Werte gehoeren NICHT ins Repository.
# (Die noch vorhandene, versehentlich committete .env wird in Phase 6 entfernt.)

# --- Client (Vite inlined alles mit VITE_-Praefix ins Bundle) ---------------
# Beide Werte sind per Design oeffentlich; die Absicherung leisten die
# RLS-Policies, nicht die Geheimhaltung dieser Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Oeffentlicher Teil des VAPID-Schluesselpaars fuer Push-Benachrichtigungen
# (pushManager.subscribe() im Client). Wie oben per Design oeffentlich.
VITE_VAPID_PUBLIC_KEY=

# Nur fuer den Firebase-Hosting-Build noetig: /api/send-invite-push gibt es
# nur bei Vercel, auf der Firebase-URL leer laesst den Aufruf ins Leere
# laufen. Dort auf die volle Vercel-Produktions-URL setzen (kein
# abschliessender Slash), z. B. https://party-box.vercel.app -- bei Vercel
# selbst leer lassen (Aufruf bleibt same-origin).
VITE_API_BASE_URL=

# --- Nur serverseitig (Vercel Environment Variables) ------------------------
# ACHTUNG: kein VITE_-Praefix. Diese Werte duerfen niemals im Client-Bundle
# oder in Git landen. Gesetzt werden sie ausschliesslich im Vercel-Dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Von Vercel Cron als "Authorization: Bearer <wert>" gesendet.
# Ist die Variable gesetzt, erzwingt /api/keep-alive sie auch.
CRON_SECRET=

# VAPID-Schluesselpaar fuer /api/send-invite-push, per
# `node -e "console.log(require('web-push').generateVAPIDKeys())"` erzeugt.
# VAPID_PUBLIC_KEY ist derselbe Wert wie VITE_VAPID_PUBLIC_KEY oben --
# zweimal, weil die Funktion selbst nicht auf VITE_-Variablen zugreifen soll
# (Trennung Client/Server bleibt an der Namenskonvention ablesbar).
# VAPID_PRIVATE_KEY ist ein echtes Geheimnis: niemals committen, niemals
# an den Client geben.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
